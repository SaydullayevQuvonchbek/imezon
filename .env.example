# ============================================================
#  IMezon — muhit o'zgaruvchilari
# ============================================================
# Bu loyiha .env faylni AVTOMATIK o'qimaydi (hech qanday .env
# kutubxonasi ulanmagan) — bu fayl faqat HUJJAT sifatida bor:
# config.php qaysi getenv() qiymatlarini kutishini ko'rsatadi.
# Sozlamasangiz ham config.php pastdagi standart qiymatlar bilan
# LOKAL ishlaydi.
#
# Haqiqiy qiymatlarni bu yerga yozmang — bu fayl versiyalash
# tizimiga qo'shiladi. Productionda buni yoki serveringizning
# muhit o'zgaruvchisi mexanizmi orqali (masalan cPanel "Setup Node.js
# App" / Apache SetEnv) yoki to'g'ridan-to'g'ri config.php ichida
# o'zgartirib bering.
# ============================================================

# MySQL server manzili
im_HOST=localhost

# MySQL foydalanuvchi nomi
im_USER=root

# MySQL paroli (lokalda OSPanel root odatda parolsiz)
im_PASS=

# Baza nomi
# Lokal (OSPanel) jonli nusxa: u1782683_imezon
im_DB=u1782683_imezon

# Kirish sahifasining to'liq manzili (login muvaffaqiyatsiz bo'lganda
# yoki tashqi havolalarda ishlatiladi)
im_SITE=http://imezon.uz/login.php

# Sayt asosiy yo'li (oxirida "/" bilan). Root domenda "/", subdirectory
# ostida bo'lsa masalan "/imezon.uz/". Bo'sh qoldirilsa config.php
# HTTP_HOST'ga qarab avtomatik aniqlaydi (localhost -> /imezon.uz/).
im_BASE=/
