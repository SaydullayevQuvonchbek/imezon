# ================================================
#   .htaccess — imezon.uz
# ================================================

Options -Indexes
RewriteEngine On

# ------------------------------------------------
# 1. HTTPS ga majburiy o'tkazish
# (faqat production serverda yoqing, localhost da o'chirilgan)
# ------------------------------------------------
# Shartli yoqilgan: localhost va 127.0.0.1 dan tashqari HAMMA joyda
# HTTPS majburiy. Ilgari butunlay izohga olingan edi — ya'ni
# productionda ham parollar ochiq HTTP orqali ketardi. Endi lokal
# ishlashga xalaqit bermay, serverda o'zi ishlaydi.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
RewriteCond %{HTTP_HOST} !\.local$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ------------------------------------------------
# 2. .php kengaytmasini URL dan yashirish
# ------------------------------------------------

# /login.php → /login (301 redirect)
# Faqat GET so'rovlari uchun (POST/AJAX ni buzmasin)
# ajax/ papkasi CHETLAB O'TILADI: u yerdagi GET so'rovlar ham
# redirect bo'lib, har bir so'rov ikki marta ketardi (oshpaz ekrani
# har 5 soniyada so'rab turadi — bekorga ikki barobar yuk).
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{REQUEST_URI} !/ajax/ [NC]
RewriteCond %{THE_REQUEST} \s(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,NE,L]

# Kengaytmasiz URL → .php faylni ichki ishlatish
# ajax/ papkasidagi fayllarni chetlab o'tish
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# ------------------------------------------------
# 3. Xavfsizlik — muhim fayllarni berkitish
# ------------------------------------------------

# config.php tashqaridan ochilmasin (faqat to'g'ridan-to'g'ri HTTP so'rovlar bloklanadi)
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# .htaccess o'zi ham ko'rinmasin
<Files ".htaccess">
    Order allow,deny
    Deny from all
</Files>

# SQL backup fayllar
<Files "*.sql">
    Order allow,deny
    Deny from all
</Files>

# Test, migration, debug, deploy fayllar
<FilesMatch "^(test|fix|reset|dump|migrate|cleanup|check|make_deploy|db_migration|ximoya)\w*\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Maxfiy kengaytmalar
<FilesMatch "\.(log|bak|old|tmp|env|ps1|cpp|txt|md|json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ------------------------------------------------
# 4. Xato sahifalari
# ------------------------------------------------
ErrorDocument 404 /login.php
ErrorDocument 403 /login.php
ErrorDocument 500 /login.php

# ------------------------------------------------
# 5. PHP sozlamalari
# ------------------------------------------------
php_flag display_errors off
php_flag log_errors on
php_value upload_max_filesize 20M
php_value post_max_size 20M
php_value max_execution_time 300
php_value memory_limit 256M

# ------------------------------------------------
# 6. Kesh (tezlashtirish)
# ------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ------------------------------------------------
# 7. GZIP kompressiya
# ------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
</IfModule>

# ------------------------------------------------
# 8. Xavfsizlik headerlari
# ------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
    Header unset Server
</IfModule>
